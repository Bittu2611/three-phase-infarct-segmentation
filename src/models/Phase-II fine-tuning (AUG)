def _elastic_deform_gray(image, alpha, sigma):
    shape = image.shape
    rng = np.random.default_rng()
    dx = gaussian_filter(rng.uniform(-1, 1, shape), sigma) * alpha
    dy = gaussian_filter(rng.uniform(-1, 1, shape), sigma) * alpha
    x, y = np.meshgrid(np.arange(shape[1]), np.arange(shape[0]))
    indices = (y + dy).reshape(-1), (x + dx).reshape(-1)
    return map_coordinates(image, indices, order=1, mode="reflect").reshape(shape)

def _static_intensity_augment(gray):
    img = gray.astype(np.float32)
    if random.random() < 0.5:
        img = np.clip(img + random.uniform(-0.15, 0.15), 0.0, 1.0)
    if random.random() < 0.5:
        img = np.clip(np.power(np.clip(img, 1e-6, 1.0), random.uniform(0.8, 1.2)), 0.0, 1.0)
    if random.random() < 0.5:
        img = gaussian_filter(img, sigma=random.uniform(0.3, 1.0))
    if random.random() < 0.5:
        img = np.clip(img + np.random.normal(0.0, random.uniform(0.01, 0.05), img.shape), 0.0, 1.0)
    if random.random() < 0.5:
        kernel = np.array([[0, -1, 0], [-1, 5, -1], [0, -1, 0]], dtype=np.float32)
        img = np.clip(cv2.filter2D(img, -1, kernel), 0.0, 1.0)
    if random.random() < 0.5:
        img = np.clip(_elastic_deform_gray(img, random.uniform(8.0, 12.0), 3.0), 0.0, 1.0)
    return img

def _static_geometric_augment(img_gray, msk_gray):
    img = img_gray.astype(np.float32)
    msk = msk_gray.astype(np.float32)
    if random.random() < 0.5:
        img = np.fliplr(img)
        msk = np.fliplr(msk)
    if random.random() < 0.5:
        img = np.flipud(img)
        msk = np.flipud(msk)
    if random.random() < 0.5:
        angle = random.uniform(-10.0, 10.0)
        h, w = img.shape[:2]
        matrix = cv2.getRotationMatrix2D((w // 2, h // 2), angle, 1.0)
        img = cv2.warpAffine(
            img, matrix, (w, h),
            flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REFLECT_101,
        )
        msk = cv2.warpAffine(
            msk, matrix, (w, h),
            flags=cv2.INTER_NEAREST, borderMode=cv2.BORDER_CONSTANT,
        )
    return img, msk

def static_random_augment_pil(img, msk):
    img_np = np.asarray(img, dtype=np.float32) / 255.0
    msk_np = np.asarray(msk, dtype=np.float32) / 255.0
    img_np, msk_np = _static_geometric_augment(img_np, msk_np)
    img_np = _static_intensity_augment(img_np)
    img_out = Image.fromarray((np.clip(img_np, 0, 1) * 255).astype(np.uint8), mode="L")
    msk_out = Image.fromarray((np.clip(msk_np, 0, 1) * 255).astype(np.uint8), mode="L")
    return img_out, msk_out

