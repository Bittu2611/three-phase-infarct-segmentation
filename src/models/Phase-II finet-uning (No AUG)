# Fine-tuning on ResNet-50 (No AUG)
import os
import re
import tensorflow as tf
from sklearn.model_selection import train_test_split
from tensorflow.keras.models import Model, load_model
from tensorflow.keras.layers import Conv2D, UpSampling2D, concatenate
from tensorflow.keras.applications import ResNet50
from tensorflow.keras.optimizers import Adam
from tensorflow.keras.losses import BinaryCrossentropy
from tensorflow.keras.metrics import AUC, Precision, Recall, KLDivergence, MeanIoU
from tensorflow.keras.callbacks import ModelCheckpoint, CSVLogger
from tensorflow.keras import mixed_precision

mixed_precision.set_global_policy("mixed_float16")
gpus = tf.config.list_physical_devices("GPU")
if gpus:
    for g in gpus:
        tf.config.experimental.set_memory_growth(g, True)
    tf.config.set_visible_devices(gpus[0], "GPU")
print("GPUs:", len(gpus))

IMG_HEIGHT, IMG_WIDTH = 256, 256
BATCH_SIZE = 8
INITIAL_LR = 1e-4
FINE_TUNE_LR = 1e-5
FROZEN_EPOCHS = 10
UNFROZEN_EPOCHS = 20
RANDOM_STATE = 42

DATA_ROOT = "/Users/abhishekjha/Desktop/MRI training/MRI 05.16.2025"
ALL_IMG_DIR = os.path.join(DATA_ROOT, "raw_images")
ALL_MSK_DIR = os.path.join(DATA_ROOT, "Binary_masked")

PRETRAINED_PATH = os.path.join(
    DATA_ROOT,
    "1818 images_trained model and data/Experiments/best_dice_1818_13_3.keras",
)

OUT_DIR = os.path.join(DATA_ROOT, "finetune_phase2_no_aug_Model_B_prime")
os.makedirs(OUT_DIR, exist_ok=True)

def iou_metric(y_true, y_pred):
    y_pred = tf.cast(y_pred > 0.5, tf.float32)
    inter = tf.reduce_sum(y_true * y_pred, axis=[1, 2, 3])
    union = tf.reduce_sum(y_true + y_pred, axis=[1, 2, 3]) - inter
    return tf.reduce_mean((inter + 1e-10) / (union + 1e-10))

def dice_coef(y_true, y_pred, smooth=1e-6):
    y_pred = tf.cast(y_pred, tf.float32)
    yt = tf.reshape(y_true, [-1])
    yp = tf.reshape(y_pred, [-1])
    inter = tf.reduce_sum(yt * yp)
    return (2 * inter + smooth) / (tf.reduce_sum(yt) + tf.reduce_sum(yp) + smooth)

def predictive_entropy_metric(y_true, y_pred):
    y_pred = tf.cast(y_pred, tf.float32)
    eps = 1e-7
    ent = -(y_pred * tf.math.log(y_pred + eps) + (1 - y_pred) * tf.math.log(1 - y_pred + eps))
    return tf.reduce_mean(ent)

def perplexity_metric(y_true, y_pred):
    y_pred = tf.cast(y_pred, tf.float32)
    bce = tf.keras.losses.binary_crossentropy(y_true, y_pred)
    return tf.reduce_mean(tf.exp(bce))

metrics_list = [
    "accuracy",
    AUC(name="auc"),
    Precision(name="precision"),
    Recall(name="recall"),
    iou_metric,
    predictive_entropy_metric,
    dice_coef,
    KLDivergence(name="kldiv"),
    perplexity_metric,
    MeanIoU(name="mean_iou", num_classes=2),
]

CUSTOM_OBJECTS = {
    "iou_metric": iou_metric,
    "dice_coef": dice_coef,
    "predictive_entropy_metric": predictive_entropy_metric,
    "perplexity_metric": perplexity_metric,
    "mean_iou": MeanIoU(name="mean_iou", num_classes=2),
    "auc": AUC(name="auc"),
    "precision": Precision(name="precision"),
    "recall": Recall(name="recall"),
    "kldiv": KLDivergence(name="kldiv"),
}

def gather_paths(img_dir, msk_dir):
    exts = (".png", ".jpg", ".jpeg", ".tif", ".tiff")
    X, Y = [], []
    for fn in sorted(os.listdir(img_dir)):
        if not fn.lower().endswith(exts):
            continue
        m = re.search(r"\d+", fn)
        img_id = m.group() if m else fn
        cands = [
            f for f in os.listdir(msk_dir)
            if img_id in f and f.lower().endswith(exts)
        ]
        if not cands:
            continue
        X.append(os.path.join(img_dir, fn))
        Y.append(os.path.join(msk_dir, cands[0]))
    return X, Y

img_paths, msk_paths = gather_paths(ALL_IMG_DIR, ALL_MSK_DIR)
print("images:", len(img_paths))

X_tr, X_val, Y_tr, Y_val = train_test_split(
    img_paths, msk_paths, test_size=0.2, random_state=RANDOM_STATE
)
print("train/val:", len(X_tr), len(X_val))

def preprocess(i_path, m_path):
    img_bytes = tf.io.read_file(i_path)
    if tf.strings.regex_full_match(i_path, r".*\.png"):
        img = tf.image.decode_png(img_bytes, channels=1)
    else:
        img = tf.image.decode_jpeg(img_bytes, channels=1)

    msk_bytes = tf.io.read_file(m_path)
    if tf.strings.regex_full_match(m_path, r".*\.png"):
        msk = tf.image.decode_png(msk_bytes, channels=1)
    else:
        msk = tf.image.decode_jpeg(msk_bytes, channels=1)

    img = tf.image.convert_image_dtype(img, tf.float32)
    msk = tf.image.convert_image_dtype(msk, tf.float32)
    img = tf.image.resize(img, [IMG_HEIGHT, IMG_WIDTH])
    msk = tf.image.resize(msk, [IMG_HEIGHT, IMG_WIDTH])
    img = tf.tile(img, [1, 1, 3])
    return img, msk

def make_ds(Xp, Yp, train=True):
    ds = tf.data.Dataset.from_tensor_slices((Xp, Yp))
    if train:
        ds = ds.shuffle(len(Xp))
    ds = ds.map(preprocess, num_parallel_calls=tf.data.AUTOTUNE)
    ds = ds.batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)
    return ds

train_ds = make_ds(X_tr, Y_tr, train=True)
val_ds = make_ds(X_val, Y_val, train=False)

def build_finetune_unet():
    enc = ResNet50(
        weights="imagenet",
        include_top=False,
        input_shape=(IMG_HEIGHT, IMG_WIDTH, 3),
    )
    skips = [
        enc.get_layer("conv1_relu").output,
        enc.get_layer("conv2_block3_out").output,
        enc.get_layer("conv3_block4_out").output,
        enc.get_layer("conv4_block6_out").output,
    ]
    x = enc.output

    def up(x_in, skip, f):
        x_in = UpSampling2D()(x_in)
        x_in = concatenate([x_in, skip])
        x_in = Conv2D(f, 3, padding="same", activation="relu")(x_in)
        x_in = Conv2D(f, 3, padding="same", activation="relu")(x_in)
        return x_in

    x = up(x, skips[-1], 512)
    x = up(x, skips[-2], 256)
    x = up(x, skips[-3], 128)
    x = up(x, skips[-4], 64)
    x = UpSampling2D()(x)
    x = Conv2D(32, 3, padding="same", activation="relu")(x)
    x = Conv2D(32, 3, padding="same", activation="relu")(x)
    out = Conv2D(1, 1, activation="sigmoid", dtype="float32")(x)
    return Model(enc.input, out), enc

model, encoder = build_finetune_unet()

print("loading pretrained weights:", PRETRAINED_PATH)
old = load_model(PRETRAINED_PATH, custom_objects=CUSTOM_OBJECTS)
old_map = {layer.name: layer for layer in old.layers}
for layer in model.layers:
    if layer.name in old_map:
        w_old = old_map[layer.name].get_weights()
        w_new = layer.get_weights()
        if w_old and all(o.shape == n.shape for o, n in zip(w_old, w_new)):
            layer.set_weights(w_old)
print("decoder weights loaded")

for lay in encoder.layers:
    lay.trainable = False
model.compile(optimizer=Adam(INITIAL_LR), loss=BinaryCrossentropy(), metrics=metrics_list)

history1 = model.fit(
    train_ds,
    validation_data=val_ds,
    epochs=FROZEN_EPOCHS,
    callbacks=[
        CSVLogger(os.path.join(OUT_DIR, "phase1_log.csv"), append=False),
        ModelCheckpoint(
            os.path.join(OUT_DIR, "best_dice_phase1_Model_B_prime.keras"),
            monitor="val_dice_coef",
            mode="max",
            save_best_only=True,
            verbose=1,
        ),
        ModelCheckpoint(
            os.path.join(OUT_DIR, "best_loss_phase1_Model_B_prime.keras"),
            monitor="val_loss",
            mode="min",
            save_best_only=True,
            verbose=1,
        ),
    ],
)

for lay in model.layers:
    lay.trainable = True
model.compile(optimizer=Adam(FINE_TUNE_LR), loss=BinaryCrossentropy(), metrics=metrics_list)

history2 = model.fit(
    train_ds,
    validation_data=val_ds,
    initial_epoch=FROZEN_EPOCHS,
    epochs=FROZEN_EPOCHS + UNFROZEN_EPOCHS,
    callbacks=[
        CSVLogger(os.path.join(OUT_DIR, "phase2_log.csv"), append=False),
        ModelCheckpoint(
            os.path.join(OUT_DIR, "best_dice_Model_B_prime.keras"),
            monitor="val_dice_coef",
            mode="max",
            save_best_only=True,
            verbose=1,
        ),
        ModelCheckpoint(
            os.path.join(OUT_DIR, "best_loss_Model_B_prime.keras"),
            monitor="val_loss",
            mode="min",
            save_best_only=True,
            verbose=1,
        ),
    ],
)

model.save(os.path.join(OUT_DIR, "final_Model_B_prime.keras"))
print("done:", OUT_DIR)
