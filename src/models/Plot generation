def squeeze_prob(pred):
    arr = np.asarray(pred, dtype=np.float32)
    while arr.ndim > 2:
        if arr.shape[0] == 1: arr = np.squeeze(arr, 0)
        elif arr.shape[-1] == 1: arr = np.squeeze(arr, -1)
        elif arr.ndim == 3: arr = arr[..., 0]
        else: break
    return np.clip(arr, 0, 1)


def binarize_prediction(pred, thresh):
    return (squeeze_prob(pred) > thresh).astype(np.uint8)


def resize_prob(prob, shape):
    H, W = shape
    return cv2.resize(prob.astype(np.float32), (W, H), interpolation=cv2.INTER_LINEAR)


def resize_mask(mask, shape):
    H, W = shape
    return cv2.resize(mask.astype(np.uint8), (W, H), interpolation=cv2.INTER_NEAREST)


def pad_to_shape(arr, shape):
    Ht, Wt = shape
    out = np.zeros((Ht, Wt), dtype=arr.dtype)
    h, w = arr.shape
    out[:h, :w] = arr
    return out


def stack_slices(slices):
    if not slices:
        return None
    H = max(s.shape[0] for s in slices)
    W = max(s.shape[1] for s in slices)
    return np.stack([pad_to_shape(s, (H, W)) for s in slices])


def process_slice(pred, shape, thresh):
    p = squeeze_prob(pred)
    m = (p > thresh).astype(np.uint8)
    return resize_prob(p, shape), resize_mask(m, shape), m


def sum_volume_map(slices, dy, dx, dz):
    vox = dy * dx * dz
    acc = None
    for sl in slices:
        c = sl.astype(np.float32) * vox
        if acc is None:
            acc = c
        elif c.shape != acc.shape:
            H = max(acc.shape[0], c.shape[0])
            W = max(acc.shape[1], c.shape[1])
            acc = pad_to_shape(acc, (H, W))
            c = pad_to_shape(c, (H, W))
            acc += c
        else:
            acc += c
    return acc


def save_side_by_side(raw, mask, title, out_path):
    fig, ax = plt.subplots(1, 2, figsize=(8, 4))
    ax[0].imshow(raw, cmap="gray"); ax[0].axis("off"); ax[0].set_title("Raw")
    ax[1].imshow(mask, cmap="gray"); ax[1].axis("off"); ax[1].set_title("Mask")
    fig.suptitle(title); plt.tight_layout()
    fig.savefig(out_path, dpi=150); plt.close(fig)


def save_overlay(raw, prob, out_path, alpha=0.45):
    raw = np.clip(raw, 0, 1)
    prob = np.clip(prob, 0, 1)
    rgb = np.stack([raw, raw, raw], -1)
    heat = plt.cm.jet(prob)[..., :3]
    m = (prob >= 0.05).astype(np.float32)[..., None]
    img = np.clip(rgb * (1 - alpha * m) + heat * (alpha * m), 0, 1)
    fig, ax = plt.subplots(figsize=(6, 6))
    ax.imshow(img); ax.axis("off")
    fig.savefig(out_path, dpi=150); plt.close(fig)


def save_prob_png(prob, out_path):
    fig, ax = plt.subplots(figsize=(5, 5))
    ax.imshow(np.clip(prob, 0, 1), cmap="jet", vmin=0, vmax=1)
    ax.axis("off")
    fig.savefig(out_path, dpi=150); plt.close(fig)


def save_stacked_jet(raw_vis, out_path):
    s = np.array(raw_vis).sum(0)
    s = (s - s.min()) / max(1e-8, s.max() - s.min())
    plt.figure(figsize=(6, 6))
    plt.imshow(plt.cm.jet(s)); plt.axis("off")
    plt.title("Stacked Raw (Jet)")
    plt.savefig(out_path, dpi=150); plt.close()


def save_heatmap(vol, out_path):
    if vol is None or not vol.size:
        return
    p = np.max(vol, 0)
    p = (p - p.min()) / max(1e-8, p.max() - p.min())
    fig, ax = plt.subplots(figsize=(7, 7))
    ax.imshow(p, cmap="jet", vmin=0, vmax=1); ax.axis("off")
    fig.savefig(out_path, dpi=150); plt.close(fig)


def save_density_map(vol, dy, dx, dz, out_path):
    if vol is None or not vol.size:
        return
    d = vol.sum(0) * dy * dx * dz
    fig, ax = plt.subplots(figsize=(7, 7))
    ax.imshow(d, cmap="hot"); ax.axis("off")
    fig.savefig(out_path, dpi=150); plt.close(fig)


def save_3d_surface(X, Y, Z, zlabel, title, out_path):
    fig = plt.figure(figsize=(10, 8))
    ax = fig.add_subplot(111, projection="3d")
    surf = ax.plot_surface(X, Y, Z, cmap="jet", alpha=0.9)
    ax.set_xlabel("X (mm)"); ax.set_ylabel("Y (mm)"); ax.set_zlabel(zlabel)
    ax.set_title(title)
    fig.colorbar(surf, shrink=0.5, aspect=10)
    plt.savefig(out_path, dpi=150); plt.close(fig)


def save_marching_cubes_mesh(vol, dy, dx, dz, mm3, out_path):
    try:
        v, f, _, _ = measure.marching_cubes(vol.astype(np.float32), 0.5, spacing=(dz, dy, dx))
    except Exception:
        return
    fig = plt.figure(figsize=(10, 8))
    ax = fig.add_subplot(111, projection="3d")
    mesh = Poly3DCollection(v[f], alpha=0.7); mesh.set_facecolor("red")
    ax.add_collection3d(mesh)
    ax.set_xlim(0, vol.shape[2] * dx); ax.set_ylim(0, vol.shape[1] * dy); ax.set_zlim(0, vol.shape[0] * dz)
    ax.set_xlabel("X (mm)"); ax.set_ylabel("Y (mm)"); ax.set_zlabel("Z (mm)")
    ax.set_title(f"3D Infarct Mesh | Total Volume = {mm3:.2f} mm³")
    plt.tight_layout(); fig.savefig(out_path, dpi=150); plt.close(fig)


def write_nifti(out_dir, prob_vol, mask_vol, dy, dx, dz):
    if not HAVE_NIB or prob_vol is None or mask_vol is None:
        return {}
    aff = np.diag([dx, dy, dz, 1.0]).astype(np.float64)
    p1 = os.path.join(out_dir, "infarct_probability.nii.gz")
    p2 = os.path.join(out_dir, "infarct_mask.nii.gz")
    nib.save(nib.Nifti1Image(prob_vol.astype(np.float32), aff), p1)
    nib.save(nib.Nifti1Image(mask_vol.astype(np.uint8), aff), p2)
    return {"infarct_probability": p1, "infarct_mask": p2}


def save_mayavi_iso(vol, dy, dx, dz, out_path, level=0.5):
    if vol is None or not vol.size:
        return
    try:
        from mayavi import mlab
        mlab.options.offscreen = True
        mlab.figure(size=(1200, 900), bgcolor=(1, 1, 1))
        src = mlab.pipeline.scalar_field(vol.astype(np.float32))
        mlab.pipeline.iso_surface(src, contours=[level], opacity=0.85, color=(0.88, 0.15, 0.15))
        mlab.view(azimuth=45, elevation=55)
        mlab.savefig(out_path); mlab.close(all=True)
    except Exception:
        m = (vol >= level).astype(np.float32)
        mm3 = m.sum() * dy * dx * dz
        save_marching_cubes_mesh(m, dy, dx, dz, mm3, out_path)


def read_spacing(out_dir):
    out_dir = Path(out_dir)
    dy = dx = dz = mm3 = None
    jf = out_dir / "spacing.json"
    if jf.is_file():
        try:
            d = json.loads(jf.read_text())
            dy, dx, dz, mm3 = d.get("dy_mm"), d.get("dx_mm"), d.get("dz_mm"), d.get("total_mm3")
        except Exception:
            pass
    sf = out_dir / "summary.txt"
    if sf.is_file():
        try:
            t = sf.read_text()
            if dy is None:
                m = re.search(r"dy_mm:\s*([0-9.+-eE]+)", t); dy = float(m.group(1)) if m else None
            if dx is None:
                m = re.search(r"dx_mm:\s*([0-9.+-eE]+)", t); dx = float(m.group(1)) if m else None
            if dz is None:
                m = re.search(r"dz_mm:\s*([0-9.+-eE]+)", t); dz = float(m.group(1)) if m else None
            if mm3 is None:
                m = re.search(r"Total Volume \(mm\^3\):\s*([0-9.+-eE]+)", t)
                mm3 = float(m.group(1)) if m else None
        except Exception:
            pass
    return float(dy or 1), float(dx or 1), float(dz or 1), (float(mm3) if mm3 is not None else None)


def load_masks(masks_dir, thresh=127):
    masks_dir = Path(masks_dir)
    if not masks_dir.is_dir():
        return []
    files = []
    for p in masks_dir.glob("mask_*.png"):
        m = re.search(r"mask_(\d+)", p.name, re.I)
        if m:
            files.append((int(m.group(1)), p))
    files.sort()
    out = []
    for _, p in files:
        mk = cv2.imread(str(p), cv2.IMREAD_GRAYSCALE)
        if mk is not None:
            out.append((mk > thresh).astype(np.float32))
    return out


def load_prob_slices(out_dir, thresh=127):
    prob_dir = Path(out_dir) / "probability"
    if prob_dir.is_dir():
        files = sorted(prob_dir.glob("prob_*.png"), key=lambda p: int(re.search(r"(\d+)", p.stem).group(1)))
        out = []
        for p in files:
            a = cv2.imread(str(p), cv2.IMREAD_GRAYSCALE)
            if a is not None:
                out.append(a.astype(np.float32) / 255.0)
        if out:
            return out
    return load_masks(out_dir / "masks", thresh)


def save_3d_plots(out_dir, vol_map, mask_vol, dy, dx, dz, mm3, skip=True):
    out_dir = Path(out_dir)
    H, W = vol_map.shape
    x = np.linspace(0, W * dx, W); y = np.linspace(0, H * dy, H)
    X, Y = np.meshgrid(x, y)
    norm = (vol_map - vol_map.min()) / max(1e-8, vol_map.max() - vol_map.min())

    p1 = out_dir / "3D_volumetric_graph_normalized.png"
    if not skip or not p1.is_file():
        save_3d_surface(X, Y, norm, "Normalized Infarct Intensity",
                        f"3D Volumetric Graph (Normalized) | Total {mm3:.2f} mm^3", str(p1))

    p2 = out_dir / "3D_surface_physical_totalZ.png"
    if not skip or not p2.is_file():
        save_3d_surface(X, Y, vol_map, "Volume (mm^3 per pixel)",
                        f"3D Surface (Physical Z) | Total {mm3:.2f} mm^3", str(p2))

    p3 = out_dir / "3D_infarct_mesh.png"
    if not skip or not p3.is_file():
        save_marching_cubes_mesh(mask_vol, dy, dx, dz, mm3, str(p3))

    return str(p1), str(p2), str(p3)


def finalize_pipeline_output(out_dir, image_dir=None, export_nifti=True, do_3d=True,
                             skip_existing=True, iso_level=0.5):
    out_dir = Path(out_dir)
    dy, dx, dz, mm3 = read_spacing(out_dir)
    masks = load_masks(out_dir / "masks")
    if not masks:
        raise FileNotFoundError(f"No masks in {out_dir / 'masks'}")

    probs = load_prob_slices(out_dir)
    mask_vol = stack_slices(masks)
    prob_vol = stack_slices(probs)
    vol_map = sum_volume_map(masks, dy, dx, dz)
    if mm3 is None:
        mm3 = float(mask_vol.sum()) * dy * dx * dz

    saved = {}
    if export_nifti and HAVE_NIB:
        saved.update(write_nifti(str(out_dir), prob_vol, mask_vol.astype(np.uint8), dy, dx, dz))

    hmap = out_dir / "infarct_probability_heatmap.png"
    if not skip_existing or not hmap.is_file():
        save_heatmap(prob_vol, str(hmap))
    saved["infarct_probability_heatmap"] = str(hmap)

    dens = out_dir / "voxel_density_map.png"
    if not skip_existing or not dens.is_file():
        save_density_map(prob_vol, dy, dx, dz, str(dens))
    saved["voxel_density_map"] = str(dens)

    if image_dir and Path(image_dir).is_dir():
        (out_dir / "overlays").mkdir(exist_ok=True)
        slices = _list_slices(image_dir)
        for i, sp in enumerate(slices):
            if i >= len(probs):
                break
            op = out_dir / "overlays" / f"overlay_{i:03d}.png"
            if skip_existing and op.is_file():
                continue
            save_overlay(_read_gray(sp), probs[i], str(op))

    if do_3d:
        p1, p2, p3 = save_3d_plots(out_dir, vol_map, mask_vol, dy, dx, dz, mm3, skip_existing)
        saved["3D_volumetric_graph_normalized"] = p1
        saved["3D_surface_physical_totalZ"] = p2
        saved["3D_infarct_mesh"] = p3
        iso = out_dir / "3D_mayavi_isosurface.png"
        if not skip_existing or not iso.is_file():
            save_mayavi_iso(prob_vol, dy, dx, dz, str(iso), iso_level)
        saved["3D_mayavi_isosurface"] = str(iso)

    return saved


def save_mri_matplotlib_plots(out_dir, raw_vis, vol_map, mask_stack, mm3, dy, dx, dz, do_3d=True):
    os.makedirs(out_dir, exist_ok=True)
    stacked = os.path.join(out_dir, "stacked_jet_image.png")
    save_stacked_jet(raw_vis, stacked)
    if not do_3d or vol_map is None:
        return {"stacked_jet_image": stacked}
    H, W = vol_map.shape
    x = np.linspace(0, W * dx, W); y = np.linspace(0, H * dy, H)
    X, Y = np.meshgrid(x, y)
    norm = (vol_map - vol_map.min()) / max(1e-8, vol_map.max() - vol_map.min())
    g1 = os.path.join(out_dir, "3D_volumetric_graph_normalized.png")
    g2 = os.path.join(out_dir, "3D_surface_physical_totalZ.png")
    g3 = os.path.join(out_dir, "3D_infarct_mesh.png")
    save_3d_surface(X, Y, norm, "Normalized Infarct Intensity",
                    f"3D Volumetric Graph (Normalized) | Total {mm3:.2f} mm^3", g1)
    save_3d_surface(X, Y, vol_map, "Volume (mm^3 per pixel)",
                    f"3D Surface (Physical Z) | Total {mm3:.2f} mm^3", g2)
    save_marching_cubes_mesh(np.stack(mask_stack), dy, dx, dz, mm3, g3)
    return {"stacked_jet_image": stacked, "3D_volumetric_graph_normalized": g1,
            "3D_surface_physical_totalZ": g2, "3D_infarct_mesh": g3}


def save_mri_plotly_html(out_dir, masks_dir, dy, dx, dz, image_dir=None, atlas_dir=None,
