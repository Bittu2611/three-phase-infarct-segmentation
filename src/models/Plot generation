                         build_plotly_surface_from_masks=None):
    os.makedirs(out_dir, exist_ok=True)
    masks_dir = Path(masks_dir)
    if not masks_dir.is_dir():
        return {}
    saved = {}
    image_dir = Path(image_dir) if image_dir else None
    atlas_dir = Path(atlas_dir) if atlas_dir and Path(atlas_dir).is_dir() else None
    if build_combined_overlay and image_dir:
        fig = build_combined_overlay(masks_dir, image_dir, dy, dx, dz, atlas_dir=atlas_dir)
        if fig:
            p = os.path.join(out_dir, "3D_combined_overlay.html")
            fig.write_html(p, include_plotlyjs=PLOTLY_JS_SOURCE, full_html=True)
            saved["3D_combined_overlay"] = p
    if build_plotly_mesh_from_masks:
        fig = build_plotly_mesh_from_masks(masks_dir, dy, dx, dz)
        if fig:
            p = os.path.join(out_dir, "3D_infarct_mesh.html")
            fig.write_html(p, include_plotlyjs=PLOTLY_JS_SOURCE, full_html=True)
            saved["3D_infarct_mesh_html"] = p
    if build_plotly_surface_from_masks:
        fig = build_plotly_surface_from_masks(masks_dir, dy, dx, dz)
        if fig:
            p = os.path.join(out_dir, "3D_surface.html")
            fig.write_html(p, include_plotlyjs=PLOTLY_JS_SOURCE, full_html=True)
            saved["3D_surface_html"] = p
    return saved


