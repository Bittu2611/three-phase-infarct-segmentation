def _list_slices(folder):
    exts = (".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff", ".dcm")
    files = [p for p in Path(folder).iterdir() if p.suffix.lower() in exts and not p.name.startswith("._")]
    files.sort(key=_slice_key)
    return [str(p) for p in files]


def _slice_key(path):
    name = Path(path).name.lower()
    if name.endswith(".dcm"):
        try:
            import pydicom
            ds = pydicom.dcmread(str(path), stop_before_pixels=True, force=True)
            ipp = getattr(ds, "ImagePositionPatient", None)
            if ipp is not None: return (0, float(ipp[2]))
            inst = getattr(ds, "InstanceNumber", None)
            if inst is not None: return (0, float(inst))
        except Exception:
            pass
        return (0, float("inf"))
    nums = re.findall(r"\d+", name)
    return (1, float(nums[-1]) if nums else float("inf"))


def _read_gray(path):
    if str(path).lower().endswith(".dcm"):
        import pydicom
        a = pydicom.dcmread(path, force=True).pixel_array.astype(np.float32)
        return (a - a.min()) / max(1e-8, a.max() - a.min())
    img = cv2.imread(str(path), cv2.IMREAD_GRAYSCALE)
    if img is None:
        raise ValueError(path)
    return img.astype(np.float32) / 255.0


